{
  "name": "wasmtypst",
  "version": "0.3.0",
  "description": "Single-world Typst compiler, language services and source navigation for browsers and Node",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "peerDependencies": {
    "monaco-editor": "^0.55.1"
  },
  "peerDependenciesMeta": {
    "monaco-editor": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./monaco": {
      "types": "./dist/monaco.d.ts",
      "import": "./dist/monaco.js"
    },
    "./wasm": "./dist/wasm/wasmtypst_bg.wasm",
    "./package.json": "./package.json",
    "./html-preview": {
      "types": "./dist/html-preview.d.ts",
      "import": "./dist/html-preview.js"
    },
    "./syntax": {
      "types": "./dist/syntax.d.ts",
      "import": "./dist/syntax.js"
    },
    "./syntax-wasm": "./dist/syntax/wasmtypst_syntax_bg.wasm",
    "./resources": {
      "types": "./dist/resources.d.ts",
      "import": "./dist/resources.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --locked --workspace && bun run node tests/sdk.mjs && bun run node tests/production.mjs && bun run node tests/syntax.mjs",
    "test:browser": "bun run node tests/browser.mjs",
    "test:package": "bun run node tests/package.mjs",
    "check": "bun run format:check && cargo fmt --check && cargo clippy --locked --workspace --all-targets -- -D warnings && bun run typecheck && bun run test && bun run test:browser && bun run test:package && bun run test:resources && bun run test:corpus",
    "serve": "bun run node scripts/serve.mjs",
    "format:check": "biome format .",
    "benchmark": "bun run node scripts/benchmark.mjs",
    "test:resources": "bun run node tests/resources.mjs",
    "test:corpus": "bun run node tests/corpus.mjs",
    "test:corpus:native": "bun run node tests/native-corpus.mjs",
    "build:memory-profiles": "bun run node scripts/build-memory-profiles.mjs",
    "benchmark:memory": "bun run node scripts/benchmark-memory.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.3",
    "@types/node": "24.13.2",
    "binaryen": "125.0.0",
    "monaco-editor": "0.55.1",
    "playwright": "1.59.1",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corca-ai/wasmtypst.git"
  },
  "homepage": "https://github.com/corca-ai/wasmtypst#readme",
  "bugs": {
    "url": "https://github.com/corca-ai/wasmtypst/issues"
  }
}
